# ─── Careervision – Client Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# NOTE: Only variables prefixed with VITE_ are exposed to the browser.

# Backend API base URL (leave blank to use Vite proxy in development)
VITE_API_URL=http://localhost:5000

# Anthropic API key – used for DIRECT browser-to-AI calls (dev/demo only).
# In production, route all AI calls through your backend instead.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
