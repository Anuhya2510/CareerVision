# ─── CareerShield AI – Server Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/careershield
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/careershield
MONGODB_URI=mongodb://localhost:27017/careershield

# ── JWT ──────────────────────────────────────────────────────────────────────
# Use a long, random string (e.g. openssl rand -base64 64)
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Anthropic ────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── CORS ─────────────────────────────────────────────────────────────────────
# The URL of your frontend (used to whitelist CORS requests)
CLIENT_URL=http://localhost:5173
